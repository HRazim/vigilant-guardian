# ============================================================================
# Vigilant Guardian — Dockerfile.worker (section 5.1)
#
# Identique à Dockerfile.api (même base Python, mêmes dépendances).
# La commande Celery worker est overridée dans docker-compose.yml :
#   command: celery -A src.workers.celery_app worker -l info -c 4
# ============================================================================

# === Stage 1: Dependencies ===
FROM python:3.11-slim AS builder

WORKDIR /app

RUN pip install poetry==1.7.1

COPY pyproject.toml poetry.lock ./

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main

# === Stage 2: Runtime ===
FROM python:3.11-slim AS runtime

WORKDIR /app

# Sécurité : utilisateur non-root (section 8.2)
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copier les dépendances installées
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copier le code source
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./
COPY knowledge_base/ ./knowledge_base/

RUN chown -R appuser:appuser /app

USER appuser

# Pas de EXPOSE ni HEALTHCHECK HTTP — c'est un worker Celery
# Le healthcheck se fait via celery inspect (docker compose healthcheck)

CMD ["celery", "-A", "src.workers.celery_app", "worker", "-l", "info", "-c", "4"]
