# ============================================================================
# Vigilant Guardian — .gitignore
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Poetry
poetry.lock

# Environment variables — JAMAIS committer (section 8.2)
.env
.env.local
.env.production

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Tests
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Celery
celerybeat-schedule
celerybeat.pid

# Logs
*.log

# Database dumps
*.sql
*.dump
