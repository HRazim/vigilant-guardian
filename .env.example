# ============================================================================
# Vigilant Guardian — Variables d'Environnement (section 10.1)
# COPIER ce fichier en .env et REMPLACER toutes les valeurs <CHANGE_ME>
# JAMAIS committer le fichier .env dans Git (section 8.2)
# ============================================================================

# Database (PostgreSQL 16)
DB_USER=vigilant
DB_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql+asyncpg://vigilant:<CHANGE_ME>@db:5432/vigilant_guardian

# Redis 7
REDIS_PASSWORD=<CHANGE_ME>
REDIS_URL=redis://:<CHANGE_ME>@redis:6379/0

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_TOKEN=<CHANGE_ME>

# LLM API Keys (section 3.4)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...

# Auth JWT (section 8.2 — RS256, exp 1h, refresh 7j)
JWT_SECRET=<CHANGE_ME_256BIT_RANDOM>
JWT_ALGORITHM=RS256

# External APIs (section 7.1)
NVD_API_KEY=...
GITHUB_TOKEN=ghp_...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
TWITTER_BEARER_TOKEN=...
